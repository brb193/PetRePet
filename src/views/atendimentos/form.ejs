<%- include('../partials/header', { titulo: atendimento ? 'Editar agendamento | PetRePet' : 'Novo agendamento | PetRePet', usuario }) %>
<div class="row justify-content-center"><div class="col-lg-8">
  <h1 class="h3 mb-3"><%= atendimento ? 'Editar agendamento' : 'Novo agendamento' %></h1>
  <% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
  <% if (!pets.length) { %><div class="alert alert-warning">Cadastre um pet antes de agendar um atendimento.</div><% } %>
  <% if (!veterinarios.length) { %><div class="alert alert-warning">Cadastre um usuário com perfil VETERINARIO antes de agendar.</div><% } %>
  <form class="card card-body border-0 shadow-sm" method="post" action="<%= atendimento ? `/atendimentos/${atendimento.id}/agendamento` : '/atendimentos' %>">
    <div class="mb-3">
      <label class="form-label" for="petId">Pet</label>
      <select class="form-select" id="petId" name="petId" required>
        <option value="">Selecione</option>
        <% pets.forEach((pet) => { %><option value="<%= pet.id %>" <%= Number(atendimento?.petId) === pet.id ? 'selected' : '' %>><%= pet.nome %> — responsável: <%= pet.cliente.nome %></option><% }) %>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label" for="veterinarioId">Veterinário</label>
      <select class="form-select" id="veterinarioId" name="veterinarioId" required>
        <option value="">Selecione</option>
        <% veterinarios.forEach((veterinario) => { %><option value="<%= veterinario.id %>" <%= Number(atendimento?.veterinarioId) === veterinario.id ? 'selected' : '' %>><%= veterinario.nome %></option><% }) %>
      </select>
    </div>
    <div class="mb-4">
      <label class="form-label" for="dataAtendimento">Data e hora</label>
      <input class="form-control" type="datetime-local" id="dataAtendimento" name="dataAtendimento" value="<%= atendimento?.dataAtendimento || '' %>">
      <div class="form-text">Se deixar em branco, será usada a data e hora atuais.</div>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-primary" type="submit" <%= pets.length && veterinarios.length ? '' : 'disabled' %>>Salvar agendamento</button>
      <a class="btn btn-outline-secondary" href="<%= atendimento ? `/atendimentos/${atendimento.id}` : '/atendimentos' %>">Cancelar</a>
    </div>
  </form>
</div></div>
<%- include('../partials/footer') %>
