<%- include('../partials/header', { titulo: registro ? 'Editar perfil | PetRePet' : 'Novo perfil | PetRePet', usuario }) %>
<div class="row justify-content-center"><div class="col-lg-7">
  <h1 class="h3 mb-3"><%= registro ? 'Editar perfil' : 'Novo perfil' %></h1>
  <% if (erro) { %><div class="alert alert-danger"><%= erro %></div><% } %>
  <form class="card card-body border-0 shadow-sm" method="post" action="<%= registro ? `/perfis/${registro.id}/editar` : '/perfis' %>">
    <div class="mb-3">
      <label class="form-label" for="nome">Nome</label>
      <input class="form-control" id="nome" name="nome" value="<%= registro?.nome || '' %>" required maxlength="80">
      <div class="form-text">Use identificadores como ADMIN, RECEPCIONISTA ou VETERINARIO.</div>
    </div>
    <div class="d-flex gap-2">
      <button class="btn btn-primary" type="submit">Salvar</button>
      <a class="btn btn-outline-secondary" href="/perfis">Cancelar</a>
    </div>
  </form>
</div></div>
<%- include('../partials/footer') %>
