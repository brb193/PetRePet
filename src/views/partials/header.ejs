<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof titulo !== 'undefined' ? titulo : 'PetRePet' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <main class="container py-5">
  <% if (typeof usuario !== 'undefined' && usuario) { %>
    <nav class="d-flex flex-wrap gap-3 align-items-center mb-4" aria-label="Navegação principal">
      <a href="/dashboard">Início</a>
      <% const perfilAtual = usuario.perfil?.nome || usuario.perfil; %>
      <% if (perfilAtual === 'ADMIN') { %>
        <a href="/perfis">Perfis</a>
        <a href="/usuarios">Usuários</a>
      <% } %>
      <% if (['ADMIN', 'RECEPCIONISTA'].includes(perfilAtual)) { %>
        <a href="/clientes">Clientes</a>
      <% } %>
      <% if (['ADMIN', 'RECEPCIONISTA', 'VETERINARIO'].includes(perfilAtual)) { %>
        <a href="/pets">Pets</a>
        <a href="/atendimentos">Atendimentos</a>
      <% } %>
      <% if (['ADMIN', 'VETERINARIO'].includes(perfilAtual)) { %>
        <a href="/prescricoes">Prescrições</a>
      <% } %>
      <span class="ms-auto text-secondary"><%= usuario.nome %> · <%= perfilAtual %></span>
      <a href="/logout">Sair</a>
    </nav>
  <% } %>
