<%- include('../partials/header', { titulo: 'Clientes | PetRePet', usuario }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3">Clientes</h1>
  <a class="btn btn-primary" href="/clientes/novo">Novo cliente</a>
</div>
<% if (mensagem) { %><div class="alert alert-info"><%= mensagem %></div><% } %>
<div class="table-responsive card border-0 shadow-sm">
  <table class="table table-striped mb-0">
    <thead><tr><th>Nome</th><th>CPF</th><th>Telefone</th><th>Endereço</th><th>Ações</th></tr></thead>
    <tbody>
      <% if (!clientes.length) { %><tr><td colspan="5" class="text-center py-4">Nenhum cliente cadastrado.</td></tr><% } %>
      <% clientes.forEach((registro) => { %>
        <tr>
          <td><%= registro.nome %></td><td><%= registro.cpf %></td><td><%= registro.telefone %></td><td><%= registro.endereco || '—' %></td>
          <td class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-primary" href="/clientes/<%= registro.id %>/editar">Editar</a>
            <form method="post" action="/clientes/<%= registro.id %>/excluir" onsubmit="return confirm('Excluir este cliente?')">
              <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
