<%- include('../partials/header', { titulo: 'Pets | PetRePet', usuario }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3">Pets</h1>
  <a class="btn btn-primary" href="/pets/novo">Novo pet</a>
</div>
<% if (mensagem) { %><div class="alert alert-info"><%= mensagem %></div><% } %>
<div class="table-responsive card border-0 shadow-sm">
  <table class="table table-striped mb-0">
    <thead><tr><th>Nome</th><th>Espécie</th><th>Raça</th><th>Nascimento</th><th>Cliente</th><th>Ações</th></tr></thead>
    <tbody>
      <% if (!pets.length) { %><tr><td colspan="6" class="text-center py-4">Nenhum pet cadastrado.</td></tr><% } %>
      <% pets.forEach((registro) => { %>
        <tr>
          <td><%= registro.nome %></td><td><%= registro.especie %></td><td><%= registro.raca %></td>
          <td><%= registro.dataNascimento ? registro.dataNascimento.toLocaleDateString('pt-BR') : '—' %></td><td><%= registro.cliente.nome %></td>
          <td class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-primary" href="/pets/<%= registro.id %>/editar">Editar</a>
            <form method="post" action="/pets/<%= registro.id %>/excluir" onsubmit="return confirm('Excluir este pet?')">
              <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
